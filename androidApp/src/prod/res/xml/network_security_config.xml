<?xml version="1.0" encoding="utf-8"?>
<!-- Prod 环境网络安全配置：强制 HTTPS 禁用明文流量，仅信任系统预置 CA 根证书 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
