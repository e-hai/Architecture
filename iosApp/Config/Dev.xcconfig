// ===================================================================
// iOS 测试环境配置文件 (Dev / Debug Environment)
// 职责：日常 Xcode 本地运行 (Cmd+R)、模拟器调试与 TestFlight 测试构建
// ===================================================================

// -------------------------------------------------------------------
// 1. 应用身份与版本信息 (Application Identity & Versions)
// -------------------------------------------------------------------
PRODUCT_BUNDLE_IDENTIFIER = xxx.yyy.zzz.dev
INFOPLIST_KEY_CFBundleDisplayName = Architecture (Dev)
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// -------------------------------------------------------------------
// 2. iOS 测试签名配置 (Code Signing)
// -------------------------------------------------------------------
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development
DEVELOPMENT_TEAM = 

// -------------------------------------------------------------------
// 3. 基础网络与 API 环境 (Network & API Gateway)
// 注：xcconfig 中 // 为注释符号，URL 协议头需使用 :/$()/ 转义
// -------------------------------------------------------------------
BASE_URL = https:/$()/dev-api.example.com
ENABLE_HTTP_LOG = YES

// -------------------------------------------------------------------
// 4. Google AdMob 官方公开测试 ID 全集 (iOS 专用，永不封号)
// 文档：https://developers.google.com/admob/ios/test-ads
// -------------------------------------------------------------------
ADMOB_APP_ID = ca-app-pub-3940256099942544~1458002511
ADMOB_BANNER_ID = ca-app-pub-3940256099942544/2934735716
ADMOB_INTERSTITIAL_ID = ca-app-pub-3940256099942544/4411468910
ADMOB_REWARDED_ID = ca-app-pub-3940256099942544/1712485313
ADMOB_APP_OPEN_ID = ca-app-pub-3940256099942544/5575463023

// -------------------------------------------------------------------
// 5. 十大商业化与基础设施 Kit 测试凭证 (Kits Test Credentials)
// -------------------------------------------------------------------
// CoreMmp (AppsFlyer 测试 Token 与 Apple App ID)
APPSFLYER_KEY = dummy_appsflyer_dev_key
APPSFLYER_APP_ID = 1234567890

// CoreAnalytics (埋点调试模式)
ANALYTICS_DEBUG_MODE = YES

// CoreAbTesting (远程配置拉取间隔)
REMOTE_CONFIG_MIN_FETCH_INTERVAL_SECONDS = 0
